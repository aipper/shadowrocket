#!name = 示例模块
#!desc = 一句话说明这个模块做什么
#!system = ios
#!author = your-name
#!homepage = https://github.com/aipper/shadowrocket
#!category = 通用
# 来源：原创
#
# 复制到 modules/ 后按需修改：
#   1. 文件名用小写 kebab-case，例如 modules/my-module.sgmodule
#   2. 脚本放在 scripts/ 下，用 https 绝对地址引用
#   3. 新增 [Script] 时同步补上 [MITM] hostname
#   4. 需要用户可调参数时，取消下面两行注释并改成自己的参数
#
# #!arguments=开关:false, 小时:0
# #!arguments-desc=开关: true=启用\n小时: 0-23

[MITM]
hostname = %APPEND% example.com

# 需要脚本时参考（命名写法支持模块参数）：
#
# [Script]
# 示例脚本 = type=http-response, pattern=^https?:\/\/example\.com\/api, script-path=https://raw.githubusercontent.com/aipper/shadowrocket/main/scripts/example.js, argument="SWITCH={{{开关}}}", requires-body=false
