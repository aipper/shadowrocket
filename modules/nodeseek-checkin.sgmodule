#!name=NodeSeek 签到
#!desc=自动签到领取鸡腿，支持 Cookie 捕获、固定奖励与鸡腿统计
#!system=ios
#!author=aipper
#!homepage=https://github.com/aipper/shadowrocket
#!category=自动签到
#!arguments=签到小时:0, 签到分钟:1, 固定奖励:false, 显示总数:false, Cookie捕获:false
#!arguments-desc=首次使用：把「Cookie捕获」改为 true，用 Shadowrocket 打开 nodeseek.com 个人页，收到通知后改回 false，之后每天自动签到。\n\n· 签到小时 / 签到分钟：24 小时制，默认 00:01\n· 固定奖励：true=固定奖励，false=随机鸡腿\n· 显示总数：true=通知中附带当前鸡腿总数\n· Cookie捕获：仅在首次配置或 Cookie 失效时临时开启
# 来源：独立实现，接口用法参考 iab0x00/ProxyRules 的 NodeSeek 模块（上游未声明许可证）

[Script]
NodeSeekCapture = type=http-response, pattern=^https:\/\/www\.nodeseek\.com\/api\/, script-path=https://raw.githubusercontent.com/aipper/shadowrocket/main/scripts/nodeseek.js, argument="ENABLE_CAPTURE={{{Cookie捕获}}}", requires-body=false, timeout=10
NodeSeekCheckin = type=cron, cronexp="{{{签到分钟}}} {{{签到小时}}} * * *", script-path=https://raw.githubusercontent.com/aipper/shadowrocket/main/scripts/nodeseek.js, argument="FIXED_REWARD={{{固定奖励}}}&SHOW_TOTAL={{{显示总数}}}", timeout=30

[MITM]
hostname = %APPEND% www.nodeseek.com
